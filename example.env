### DEPLOYMENT MODE ###
# The web app defaults to online; install.sh defaults to embedded on the Pi.
AGNERD_DEPLOYMENT_MODE=online
# Embedded runtime requires LOCAL_DATABASE_URL. The Pi installer provisions
# /etc/agnerd/database.env, then writes the real URL to the checkout .env and
# /etc/agnerd/.env. Cloud URLs are ignored for embedded application queries.
# LOCAL_DATABASE_URL=postgresql://username:password@127.0.0.1:5432/agnerd

### OPTIONAL MANUAL EMBEDDED BACKUPS ###
EMBEDDED_DEVICE_ID=
# HTTPS URL to the online app's /api/embedded/backups endpoint.
EMBEDDED_SYNC_URL=
# Same 32+ character secret on Pi and online server. Never expose to browser.
EMBEDDED_SYNC_TOKEN=
# Operator emails permitted to export/download the whole business database.
EMBEDDED_SYNC_ADMIN_EMAILS=
# Online server only: registered device IDs, comma-separated.
EMBEDDED_ALLOWED_DEVICE_IDS=

### Node.js options ###
# Use --inspect to enable the Node.js inspector for debugging
NODE_OPTIONS=--inspect

### PRISMA DATABASE URLS
# Embedded installs import business data from the configured cloud URL when
# reachable and the local database is empty. Application runtime stays local.
PRISMA_DATABASE_URL="postgresql://user:password@localhost:5432/dbname?schema=public"

### BETTER AUTH CONFIGURATION ###
BETTER_AUTH_SECRET=super-secret-code
# Base URL of your app. Keep comments on separate lines for systemd EnvironmentFile compatibility.
BETTER_AUTH_URL=http://localhost:3000
# Add each browser origin used to access the app, comma-separated (for example, the device LAN origin).
BETTER_AUTH_TRUSTED_ORIGINS=http://127.0.0.1:3000

### EMAIL CONFIGURATION ###
BREVO_API_KEY="super-secret-brevo-api-key"
EMAIL_HOST="smtp-relay.brevo.com"
EMAIL_PORT=587
EMAIL_USER="brevo-email-user@smtp-brevo.com"
EMAIL_PASSWORD="email-password"
EMAIL_FROM="no-reply@your-domain.com.au"

### CESIUM ION TOKEN ###
NEXT_PUBLIC_CESIUM_ION_TOKEN="super-secret-cesium-ion-token"

### OPTIONAL OFFLINE IMAGERY (EMBEDDED MODE ONLY) ###
# Enable after preparing/copying the dataset. Leave empty for existing online imagery.
LOCAL_IMAGERY_DATASET=
LOCAL_IMAGERY_ROOT=/var/lib/agnerd/maps
