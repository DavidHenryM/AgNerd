[Unit]
Description=AgNerd Service
After=postgresql.service network.target
Wants=postgresql.service

[Service]
Type=simple
WorkingDirectory=/opt/agnerd
EnvironmentFile=/etc/agnerd/.env
EnvironmentFile=/etc/agnerd/database.env
ExecStart=/usr/bin/npm start
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
