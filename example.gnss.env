### GNSS CONFIGURATION ###
# GNSS live source for gnss-reader.mjs
# gpsd: read live fixes from gpsd TCP stream
# serial: read NMEA/UBX directly from serial device
GNSS_SOURCE=serial
GNSS_READ_DEVICE="/dev/ttyAMA0"
GNSS_READ_BAUDRATE=115200
# Receive RTCM from the NTRIP forwarder's TCP output using the same UART.
GNSS_CORRECTIONS_ENABLED=true
GNSS_CORRECTION_HOST=localhost
GNSS_CORRECTION_PORT=2101
GNSS_CORRECTION_RECONNECT_MS=3000
GNSS_CORRECTION_TIMEOUT_MS=30000
# 5 Hz status publication; configure receiver measurement period to 200 ms too.
GNSS_POST_INTERVAL_MS=200
GNSS_INGEST_URL="http://localhost:3000/api/gnss/position"
GNSS_INTERNAL_TOKEN="super-secret-gnss-internal-token"
GNSS_STATUS_FILE="/tmp/agnerd-gnss-status.json"
GNSS_STATUS_FALLBACK_FILE="/var/tmp/agnerd-gnss-status.json"

### GPSD CONFIGURATION ###
GPSD_PORT=2947
GPSD_HOST=127.0.0.1
GPSD_RECONNECT_MS=3000

### IMU / SENSOR FUSION (Adafruit 4517 LSM6DSOX + LIS3MDL on the Qwiic port) ###
# agnerd-imu reads the sensor; gnss-reader fuses it with GNSS course for display only.
# Spray coverage, tracks and history always use raw GNSS fixes.
IMU_I2C_BUS=1
IMU_ACCEL_GYRO_ADDRESS=0x6a
IMU_MAG_ADDRESS=0x1c
IMU_ODR_HZ=208
# Vehicle forward,left,up expressed as sensor axes. Board mounted with y up, x to the left, z forward.
IMU_AXIS_MAP="+z,+x,+y"
# Magnetometer axes if they differ from the accelerometer/gyro axes.
IMU_MAG_AXIS_MAP="+z,+x,+y"
IMU_MAG_ENABLED=true
IMU_STATUS_FILE="/tmp/agnerd-imu-status.json"
IMU_CALIBRATION_FILE="/var/lib/agnerd/imu-calibration.json"
# 20 Hz fused display publication; 0 disables the display stream.
GNSS_DISPLAY_INTERVAL_MS=50
GNSS_DISPLAY_FILE="/tmp/agnerd-gnss-display.json"
GNSS_IMU_ENABLED=true
GNSS_FUSION_STATE_FILE="/var/lib/agnerd/heading-fusion.json"
GNSS_FUSION_MIN_COURSE_SPEED_MPS=0.8
GNSS_FUSION_MAG_ENABLED=true
# Optional starting compass offset (declination plus mount yaw); it is learned while driving.
GNSS_FUSION_MAG_DECLINATION_DEG=0
