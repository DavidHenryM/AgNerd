### GNSS CONFIGURATION ###
# GNSS live source for gnss-reader.mjs
# gpsd: read live fixes from gpsd TCP stream (recommended)
# serial: read NMEA/UBX directly from serial device
GNSS_SOURCE=serial
GNSS_READ_DEVICE="/dev/serial0"
GNSS_READ_BAUDRATE=38400
GNSS_POST_INTERVAL_MS=1000
GNSS_INGEST_URL="http://localhost:3000/api/gnss/position"
GNSS_INTERNAL_TOKEN="super-secret-gnss-internal-token"
GNSS_STATUS_FILE="/tmp/agnerd-gnss-status.json"
GNSS_STATUS_FALLBACK_FILE="/var/tmp/agnerd-gnss-status.json"

### GPSD CONFIGURATION ###
GPSD_PORT=2947
GPSD_HOST=127.0.0.1
GPSD_RECONNECT_MS=3000
